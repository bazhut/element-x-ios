// Analytics and Diagnostics

import "package://pkg.pkl-lang.org/github.com/element-hq/pkl-tools/staticcode@1.1.0#/StaticCode.pkl"

sentryDSN: String? = read?("env:SENTRY_DSN")
sentryRustDSN: String? = read?("env:SENTRY_RUST_DSN")
postHogHost: String? = read?("env:POSTHOG_HOST")
postHogAPIKey: String? = read?("env:POSTHOG_API_KEY")
rageshakeURL: String? = read?("env:RAGESHAKE_URL")
mapLibreAPIKey: String? = read?("env:MAPLIBRE_API_KEY")

// Custom emojis

sharedEmojiPackURL: String? = read?("env:SHARED_EMOJI_PACK_URL")

// Push notifications

pushGatewayBaseURL: String? = read?("env:PUSH_GATEWAY_BASE_URL")

output {
  renderer = new StaticCode.Renderer {
    language = "Swift"
    objectName = "Secrets"
    isolation = "nonisolated"
  }
}
